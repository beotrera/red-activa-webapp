# URL base del backend — INCLUYE el prefijo "/api" (sin trailing slash).
# Las rutas individuales (/auth/login, /persons, etc.) se concatenan en el código
# tal como están documentadas en el contrato de API.
# Ejemplos:
#   Desarrollo local → http://localhost:3001/api
#   Producción       → https://api.redactiva.gob.ar/api
VITE_API_BASE_URL="http://localhost:3001/api"
